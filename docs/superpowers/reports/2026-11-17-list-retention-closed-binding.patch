+
+pub static PROTO_CLOSED: std::sync::LazyLock<std::sync::Mutex<std::collections::HashSet<(u32, u32)>>> =
+    std::sync::LazyLock::new(|| std::sync::Mutex::new(std::collections::HashSet::new()));
+
+/// True when every local ref in `syn` stays within the `k` slots of the
+/// enclosing let frame (`s` = lower bound on frames introduced since).
+fn proto_closed(syn: &StgSyn, s: usize, k: usize) -> bool {
+    let r = |x: &Ref| match x {
+        crate::eval::stg::syntax::Reference::L(i) => *i < s + k,
+        _ => true,
+    };
+    let c = |x: &StgSyn, s2: usize| proto_closed(x, s2, k);
+    match syn {
+        StgSyn::Atom { evaluand } => r(evaluand),
+        StgSyn::Case { scrutinee, branches, fallback } => {
+            c(scrutinee, s)
+                && branches.iter().all(|(t, b)| c(b, s + tag_lb(*t)))
+                && fallback.as_ref().is_none_or(|f| c(f, s + 1))
+        }
+        StgSyn::Cons { args, .. } | StgSyn::Bif { args, .. } => args.iter().all(r),
+        StgSyn::App { callable, args, .. } | StgSyn::DirectApp { callable, args, .. } => {
+            r(callable) && args.iter().all(r)
+        }
+        StgSyn::Let { bindings, body } => {
+            // Bindings close over the outer env; body sees a new frame.
+            bindings.iter().all(|lf| c(lf.body(), s + lf.arity() as usize))
+                && c(body, s + bindings.len())
+        }
+        StgSyn::LetRec { bindings, body } => {
+            let s2 = s + bindings.len();
+            bindings.iter().all(|lf| c(lf.body(), s2 + lf.arity() as usize)) && c(body, s2)
+        }
+        StgSyn::Ann { body, .. } => c(body, s),
+        StgSyn::Meta { meta, body } => r(meta) && r(body),
+        StgSyn::DeMeta { scrutinee, handler, or_else } => {
+            c(scrutinee, s) && c(handler, s) && c(or_else, s)
+        }
+        StgSyn::Seq { scrutinee, body } => c(scrutinee, s) && c(body, s),
+        StgSyn::LookupLit { key, obj, default, .. } => r(key) && r(obj) && r(default),
+        StgSyn::FusedPrimop { left, right, inner, .. } => r(left) && r(right) && c(inner, s),
+        StgSyn::BlackHole => true,
+    }
+}
+
+fn tag_lb(t: u8) -> usize {
+    match t {
+        3..=5 | 11 | 17 => 1,
+        7 => 2,
+        _ => 0,
+    }
+}
