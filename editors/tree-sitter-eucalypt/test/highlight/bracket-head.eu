# Bracket-pair declaration heads (eu-jd7l4): the operand is always a list,
# so a block pattern destructures a list item; every name it binds is a
# parameter, as in rowan. Each bracket character is three bytes and the
# carets count bytes, so a caret sits two columns right of its name.

⟦ [{m}] ⟧: m
#     ^ parameter

⟪ [{k: kk, m}] ⟫: [kk, m]
#     ^ parameter
#        ^ parameter
#            ^ parameter

⌈ [h: t] ⌉: h
#    ^ parameter
#       ^ parameter

⟨ x ⟩: x
#   ^ parameter

(⟦ [{n}] ⟧): n
#      ^ parameter
