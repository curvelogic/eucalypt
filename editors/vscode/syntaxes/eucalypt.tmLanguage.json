{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Eucalypt",
  "scopeName": "source.eucalypt",
  "comment": "Follows the rowan lexer (src/syntax/rowan/lex.rs, string_lex.rs) and the LSP semantic token classes (src/driver/lsp/semantic.rs). The prelude-function and prelude-variable patterns are generated by scripts/generate-prelude-names.js.",
  "patterns": [
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "expression": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#docstring"
        },
        {
          "include": "#t-string"
        },
        {
          "include": "#s-string"
        },
        {
          "include": "#c-string"
        },
        {
          "include": "#raw-string"
        },
        {
          "include": "#string"
        },
        {
          "include": "#block-meta"
        },
        {
          "include": "#symbol"
        },
        {
          "include": "#number"
        },
        {
          "include": "#metadata-block"
        },
        {
          "include": "#metadata-backtick"
        },
        {
          "include": "#operator-declaration"
        },
        {
          "include": "#bracket-declaration"
        },
        {
          "include": "#function-declaration"
        },
        {
          "include": "#property-declaration"
        },
        {
          "include": "#builtin-intrinsic"
        },
        {
          "include": "#language-constant"
        },
        {
          "include": "#prelude-function"
        },
        {
          "include": "#prelude-variable"
        },
        {
          "include": "#anaphor"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#bracket"
        },
        {
          "include": "#assertion-operator"
        },
        {
          "include": "#operator"
        },
        {
          "include": "#punctuation"
        },
        {
          "include": "#identifier"
        }
      ]
    },
    "comment": {
      "name": "comment.line.number-sign.eucalypt",
      "match": "#.*$"
    },
    "docstring": {
      "comment": "A string straight after backtick metadata: the declaration's documentation (markdown).",
      "begin": "(`)(\\s*)(\")",
      "end": "\"",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.metadata.eucalypt punctuation.definition.metadata.eucalypt"
        },
        "3": {
          "name": "string.quoted.double.documentation.eucalypt punctuation.definition.string.begin.eucalypt"
        }
      },
      "endCaptures": {
        "0": {
          "name": "string.quoted.double.documentation.eucalypt punctuation.definition.string.end.eucalypt"
        }
      },
      "contentName": "string.quoted.double.documentation.eucalypt",
      "patterns": [
        {
          "include": "#brace-escape"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#markdown-inline"
        }
      ]
    },
    "t-string": {
      "comment": "t\"...\": zoned date-time literal; no interpolation, no escapes.",
      "name": "string.quoted.double.datetime.eucalypt",
      "begin": "t\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.eucalypt"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.eucalypt"
        }
      }
    },
    "s-string": {
      "comment": "s\"...\": type-data literal; no interpolation, no escapes.",
      "name": "string.quoted.double.type-data.eucalypt",
      "begin": "s\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.eucalypt"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.eucalypt"
        }
      }
    },
    "c-string": {
      "comment": "c\"...\": backslash escapes, including \\{ and \\} for literal braces; '{{' is not an escape.",
      "name": "string.quoted.double.c.eucalypt",
      "begin": "c\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.eucalypt"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.eucalypt"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.eucalypt",
          "match": "\\\\(?:[nrt0\\\\\"{}]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})"
        },
        {
          "name": "invalid.illegal.escape.eucalypt",
          "match": "\\\\."
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "raw-string": {
      "comment": "r\"...\": backslashes are literal; interpolation and '{{' / '}}' as in plain strings.",
      "name": "string.quoted.double.raw.eucalypt",
      "begin": "r\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.eucalypt"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.eucalypt"
        }
      },
      "patterns": [
        {
          "include": "#brace-escape"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.eucalypt",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.eucalypt"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.eucalypt"
        }
      },
      "patterns": [
        {
          "include": "#brace-escape"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "brace-escape": {
      "comment": "'{{' and '}}' in plain and raw strings; matched before interpolation so '{{{x}' is an escape then '{x}'.",
      "name": "constant.character.escape.eucalypt",
      "match": "\\{\\{|\\}\\}"
    },
    "interpolation": {
      "comment": "{target}, {a.b}, { x }, {0}, {} and {x:%spec}; a target runs to whitespace, '}', ':' or '.'.",
      "name": "meta.interpolation.eucalypt",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.eucalypt"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.eucalypt"
        }
      },
      "patterns": [
        {
          "match": "(:)([^}]*)",
          "captures": {
            "1": {
              "name": "punctuation.separator.format-spec.eucalypt"
            },
            "2": {
              "name": "string.other.format-spec.eucalypt"
            }
          }
        },
        {
          "name": "keyword.operator.accessor.eucalypt",
          "match": "\\."
        },
        {
          "name": "variable.other.interpolation.eucalypt",
          "match": "[^\\s}:.]+"
        }
      ]
    },
    "markdown-inline": {
      "patterns": [
        {
          "name": "markup.inline.raw.eucalypt",
          "match": "`[^`]+`"
        },
        {
          "name": "markup.bold.eucalypt",
          "match": "\\*\\*[^*]+\\*\\*"
        },
        {
          "name": "markup.italic.eucalypt",
          "match": "(?<![*])\\*[^*]+\\*(?![*])"
        }
      ]
    },
    "block-meta": {
      "comment": "A symbol opening a block is its metadata: { :for ... }, { :do ... }, { :state ... }, { :let ... }, { :monad ... }.",
      "match": "(\\{)\\s*(:(?:[\\p{Alphabetic}_•$?][\\p{Alphabetic}\\p{N}_$?!\\-*]*+|'[^']*'))",
      "captures": {
        "1": {
          "name": "punctuation.definition.block.begin.eucalypt"
        },
        "2": {
          "name": "constant.other.symbol.block-meta.eucalypt"
        }
      }
    },
    "symbol": {
      "patterns": [
        {
          "name": "constant.other.symbol.eucalypt",
          "match": ":[\\p{Alphabetic}_•$?][\\p{Alphabetic}\\p{N}_$?!\\-*]*+"
        },
        {
          "name": "constant.other.symbol.quoted.eucalypt",
          "match": ":'[^']*'"
        }
      ]
    },
    "number": {
      "comment": "Integer or decimal; a '-' directly before a digit is part of the literal, as in the lexer.",
      "name": "variable.other.eucalypt",
      "match": "-?[0-9]+(?:\\.[0-9]*)?"
    },
    "metadata-block": {
      "comment": "Backtick metadata given as a block: ` { doc: ... associates: :right }. Its keys are metadata names.",
      "begin": "(`)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.metadata.eucalypt punctuation.definition.metadata.eucalypt"
        },
        "2": {
          "name": "punctuation.definition.block.begin.eucalypt"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.eucalypt"
        }
      },
      "name": "meta.metadata.eucalypt",
      "patterns": [
        {
          "include": "#metadata-content"
        }
      ]
    },
    "metadata-content": {
      "patterns": [
        {
          "match": "([\\p{Alphabetic}_•$?][\\p{Alphabetic}\\p{N}_$?!\\-*]*+|'[^']*')(?=\\s*:(?![\\p{Alphabetic}_•$?]|'))",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.metadata.eucalypt"
            }
          }
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.block.begin.eucalypt"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.block.end.eucalypt"
            }
          },
          "patterns": [
            {
              "include": "#metadata-content"
            }
          ]
        },
        {
          "include": "#expression"
        }
      ]
    },
    "metadata-backtick": {
      "name": "keyword.other.metadata.eucalypt punctuation.definition.metadata.eucalypt",
      "match": "`"
    },
    "operator-declaration": {
      "comment": "Operator declaration heads: (l op r):, (op x):, (x op): and nullary (op):.",
      "patterns": [
        {
          "match": "(\\()\\s*([[\\p{S}\\p{Pc}\\p{Pd}\\p{Po}]&&[^\"'_,:#`•$?]][[\\p{S}\\p{Pc}\\p{Pd}\\p{Po}]&&[^\"'_,:]]*+)\\s*(\\))(?=\\s*:(?![\\p{Alphabetic}_•$?]|'))",
          "captures": {
            "1": {
              "name": "punctuation.definition.paren.begin.eucalypt"
            },
            "2": {
              "name": "keyword.operator.declaration.eucalypt"
            },
            "3": {
              "name": "punctuation.definition.paren.end.eucalypt"
            }
          }
        },
        {
          "match": "(\\()\\s*([\\p{Alphabetic}_•$?][\\p{Alphabetic}\\p{N}_$?!\\-*]*+)\\s*([[\\p{S}\\p{Pc}\\p{Pd}\\p{Po}]&&[^\"'_,:#`•$?]][[\\p{S}\\p{Pc}\\p{Pd}\\p{Po}]&&[^\"'_,:]]*+)\\s*([\\p{Alphabetic}_•$?][\\p{Alphabetic}\\p{N}_$?!\\-*]*+)\\s*(\\))(?=\\s*:(?![\\p{Alphabetic}_•$?]|'))",
          "captures": {
            "1": {
              "name": "punctuation.definition.paren.begin.eucalypt"
            },
            "2": {
              "name": "variable.parameter.eucalypt"
            },
            "3": {
              "name": "keyword.operator.declaration.eucalypt"
            },
            "4": {
              "name": "variable.parameter.eucalypt"
            },
            "5": {
              "name": "punctuation.definition.paren.end.eucalypt"
            }
          }
        },
        {
          "match": "(\\()\\s*([[\\p{S}\\p{Pc}\\p{Pd}\\p{Po}]&&[^\"'_,:#`•$?]][[\\p{S}\\p{Pc}\\p{Pd}\\p{Po}]&&[^\"'_,:]]*+)\\s*([\\p{Alphabetic}_•$?][\\p{Alphabetic}\\p{N}_$?!\\-*]*+)\\s*(\\))(?=\\s*:(?![\\p{Alphabetic}_•$?]|'))",
          "captures": {
            "1": {
              "name": "punctuation.definition.paren.begin.eucalypt"
            },
            "2": {
              "name": "keyword.operator.declaration.eucalypt"
            },
            "3": {
              "name": "variable.parameter.eucalypt"
            },
            "4": {
              "name": "punctuation.definition.paren.end.eucalypt"
            }
          }
        },
        {
          "match": "(\\()\\s*([\\p{Alphabetic}_•$?][\\p{Alphabetic}\\p{N}_$?!\\-*]*+)\\s*([[\\p{S}\\p{Pc}\\p{Pd}\\p{Po}]&&[^\"'_,:#`•$?]][[\\p{S}\\p{Pc}\\p{Pd}\\p{Po}]&&[^\"'_,:]]*+)\\s*(\\))(?=\\s*:(?![\\p{Alphabetic}_•$?]|'))",
          "captures": {
            "1": {
              "name": "punctuation.definition.paren.begin.eucalypt"
            },
            "2": {
              "name": "variable.parameter.eucalypt"
            },
            "3": {
              "name": "keyword.operator.declaration.eucalypt"
            },
            "4": {
              "name": "punctuation.definition.paren.end.eucalypt"
            }
          }
        }
      ]
    },
    "bracket-declaration": {
      "comment": "Idiot bracket declaration head: ⟦ xs ⟧:, ⌈[f: rest]⌉:, ⌈{}⌉:.",
      "match": "([[\\p{Ps}\\p{Pi}]&&[^(\\[{]])((?:[^\\p{Pe}\\p{Pf}]|[)\\]}])*?)([[\\p{Pe}\\p{Pf}]&&[^)\\]}]])(?=\\s*:(?![\\p{Alphabetic}_•$?]|'))",
      "captures": {
        "1": {
          "name": "keyword.operator.bracket.declaration.eucalypt"
        },
        "2": {
          "patterns": [
            {
              "include": "#parameters"
            }
          ]
        },
        "3": {
          "name": "keyword.operator.bracket.declaration.eucalypt"
        }
      }
    },
    "function-declaration": {
      "comment": "Function declaration heads: f(x, y):, f[a, b]:, f{x y}:, with destructuring parameters ([a, b], {x y}, [h : t]).",
      "match": "([\\p{Alphabetic}_•$?][\\p{Alphabetic}\\p{N}_$?!\\-*]*+|'[^']*')((?<grp>\\((?:[^()\\[\\]{}]|\\g<grp>)*\\)|\\[(?:[^()\\[\\]{}]|\\g<grp>)*\\]|\\{(?:[^()\\[\\]{}]|\\g<grp>)*\\}))(?=\\s*:(?![\\p{Alphabetic}_•$?]|'))",
      "captures": {
        "1": {
          "name": "entity.name.function.eucalypt"
        },
        "2": {
          "patterns": [
            {
              "include": "#parameters"
            }
          ]
        }
      }
    },
    "parameters": {
      "patterns": [
        {
          "name": "punctuation.definition.paren.begin.eucalypt",
          "match": "\\("
        },
        {
          "name": "punctuation.definition.paren.end.eucalypt",
          "match": "\\)"
        },
        {
          "name": "punctuation.definition.list.begin.eucalypt",
          "match": "\\["
        },
        {
          "name": "punctuation.definition.list.end.eucalypt",
          "match": "\\]"
        },
        {
          "name": "punctuation.definition.block.begin.eucalypt",
          "match": "\\{"
        },
        {
          "name": "punctuation.definition.block.end.eucalypt",
          "match": "\\}"
        },
        {
          "name": "punctuation.separator.comma.eucalypt",
          "match": ","
        },
        {
          "name": "punctuation.separator.cons.eucalypt",
          "match": ":"
        },
        {
          "name": "variable.parameter.eucalypt",
          "match": "[\\p{Alphabetic}_•$?][\\p{Alphabetic}\\p{N}_$?!\\-*]*+|'[^']*'"
        }
      ]
    },
    "property-declaration": {
      "comment": "Property declaration head: name: or 'quoted name':, anywhere a declaration can start.",
      "match": "([\\p{Alphabetic}_•$?][\\p{Alphabetic}\\p{N}_$?!\\-*]*+|'[^']*')(?=\\s*:(?![\\p{Alphabetic}_•$?]|'))",
      "captures": {
        "1": {
          "name": "variable.other.property.declaration.eucalypt"
        }
      }
    },
    "builtin-intrinsic": {
      "comment": "Built-in intrinsics: __NAME.",
      "name": "support.function.builtin.eucalypt",
      "match": "(?<![\\p{Alphabetic}\\p{N}_$?!\\-*•])__[A-Z][A-Z0-9_]*(?![\\p{Alphabetic}\\p{N}_$?!\\-*])"
    },
    "language-constant": {
      "name": "constant.language.eucalypt",
      "match": "(?<![\\p{Alphabetic}\\p{N}_$?!\\-*•])(?<!\\.)(?:true|false|null)(?![\\p{Alphabetic}\\p{N}_$?!\\-*])"
    },
    "prelude-function": {
      "comment": "Generated by scripts/generate-prelude-names.js: prelude functions.",
      "name": "support.function.prelude.eucalypt",
      "match": "(?<![\\p{Alphabetic}\\p{N}_$?!\\-*•.])(?:group\\-consecutive\\-by|match\\-filter\\-values|over\\-sliding\\-pairs|deep\\-query\\-first|deep\\-query\\-paths|deep\\-find\\-first|deep\\-find\\-paths|deep\\-query\\-fold|update\\-value\\-or|deep\\-transform|stream\\-advance|__require\\-int|deep\\-merge\\-at|filter\\-values|lookup\\-across|partition\\-all|random\\-stream|__dbg\\-render|by\\-key\\-match|discriminate|filter\\-items|lookup\\-or\\-in|map\\-as\\-block|map\\-elements|update\\-first|update\\-value|__dbg\\-after|alter\\-value|by\\-key\\-name|lookup\\-alts|lookup\\-path|random\\-bind|sort\\-by\\-num|sort\\-by\\-str|sort\\-by\\-zdt|split\\-after|__split\\-at|complement|deep\\-query|drop\\-until|drop\\-while|interleave|map\\-second|map\\-values|merge\\-meta|par\\-concat|parse\\-args|random\\-ret|split\\-when|take\\-until|take\\-while|update\\-nth|window\\-all|__dbg\\-val|all\\-true\\?|any\\-true\\?|deep\\-find|deep\\-fold|is\\-array\\?|lookup\\-in|lookup\\-or|map\\-first|max\\-of\\-by|max\\-of\\-or|merge\\-all|min\\-of\\-by|min\\-of\\-or|partition|render\\-as|second\\-or|set\\-value|sort\\-keys|sort\\-strs|sort\\-zdts|transpose|zip\\-apply|by\\-value|coalesce|group\\-by|identity|kv\\-block|map\\-keys|merge\\-at|parse\\-as|split\\-at|split\\-on|as\\-spec|butlast|compose|head\\-or|iterate|max\\-map|min\\-map|par\\-map|par\\-max|par\\-min|par\\-sum|product|reverse|sort\\-by|tail\\-or|uncurry|__drop|__take|append|assert|by\\-key|concat|dissoc|filter|lookup|map\\-kv|mapcat|match\\?|max\\-of|min\\-of|nub\\-by|reduce|remove|render|repeat|rotate|second|select|tongue|update|values|window|zip\\-kv|alter|apply|bimap|const|count|cross|curry|cycle|foldl|foldr|monad|qsort|range|scanl|scanr|tails|unzip|drop|flip|fnil|iota|juxt|keys|map2|pair|quot|snoc|take|then|uniq|when|abs|all|any|dbg|div|has|map|max|min|mod|nth|pow|rem|sum)(?![\\p{Alphabetic}\\p{N}_$?!\\-*])"
    },
    "prelude-variable": {
      "comment": "Generated by scripts/generate-prelude-names.js: prelude properties and namespaces.",
      "name": "support.variable.prelude.eucalypt",
      "match": "(?<![\\p{Alphabetic}\\p{N}_$?!\\-*•.])(?:group\\-consecutive|differences|running\\-max|running\\-min|running\\-sum|deep\\-merge|type\\-data\\?|datetime\\?|ints\\-from|sort\\-nums|with\\-keys|with\\-meta|elements|list\\-map|non\\-nil\\?|raw\\-meta|zip\\-with|ceiling|number\\?|prepend|string\\?|symbol\\?|_block|block\\?|negate|random|block|bool\\?|first|floor|graph|list\\?|merge|null\\?|panic|value|zero\\?|any\\?|cond|cons|dict|head|last|meta|neg\\?|nil\\?|pos\\?|tail|and|arr|bit|cal|dec|for|inc|key|let|nil|not|num|set|str|sym|vec|zip|ch|eu|if|io|or|ℕ)(?![\\p{Alphabetic}\\p{N}_$?!\\-*])"
    },
    "anaphor": {
      "comment": "Expression and block anaphora: _, _0, •, •1.",
      "name": "variable.language.anaphor.eucalypt",
      "match": "(?<![\\p{Alphabetic}\\p{N}_$?!\\-*•])(?:_[0-9]*|•[0-9]*)(?![\\p{Alphabetic}\\p{N}_$?!\\-*])"
    },
    "function-call": {
      "comment": "Call: a name directly followed by (, [ or { (juxtaposed call).",
      "match": "([\\p{Alphabetic}_•$?][\\p{Alphabetic}\\p{N}_$?!\\-*]*+|'[^']*')(?=[(\\[{])",
      "captures": {
        "1": {
          "name": "entity.name.function.call.eucalypt"
        }
      }
    },
    "bracket": {
      "comment": "Idiot brackets: any non-ASCII Ps/Pi opener and Pe/Pf closer (⟦ ⟧, « », ⌈ ⌉, ‹ ›, ...).",
      "patterns": [
        {
          "name": "keyword.operator.bracket.begin.eucalypt",
          "match": "[[\\p{Ps}\\p{Pi}]&&[^(\\[{]]"
        },
        {
          "name": "keyword.operator.bracket.end.eucalypt",
          "match": "[[\\p{Pe}\\p{Pf}]&&[^)\\]}]]"
        }
      ]
    },
    "assertion-operator": {
      "comment": "Metadata and assertion operators.",
      "patterns": [
        {
          "name": "keyword.operator.assertion.eucalypt",
          "match": "(?://=\\?>|//=>|//=\\?|//=|//!)(?![[\\p{S}\\p{Pc}\\p{Pd}\\p{Po}]&&[^\"'_,:]])"
        },
        {
          "name": "keyword.operator.metadata.eucalypt",
          "match": "(?://<<|//)(?![[\\p{S}\\p{Pc}\\p{Pd}\\p{Po}]&&[^\"'_,:]])"
        }
      ]
    },
    "operator": {
      "name": "keyword.operator.eucalypt",
      "match": "[[\\p{S}\\p{Pc}\\p{Pd}\\p{Po}]&&[^\"'_,:#`•$?]][[\\p{S}\\p{Pc}\\p{Pd}\\p{Po}]&&[^\"'_,:]]*+"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.block.begin.eucalypt",
          "match": "\\{"
        },
        {
          "name": "punctuation.definition.block.end.eucalypt",
          "match": "\\}"
        },
        {
          "name": "punctuation.definition.list.begin.eucalypt",
          "match": "\\["
        },
        {
          "name": "punctuation.definition.list.end.eucalypt",
          "match": "\\]"
        },
        {
