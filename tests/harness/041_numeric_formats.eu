"Examples from https://alvinalexander.com/programming/printf-format-cheat-sheet"

format: str.format

int-widths: {
  α: 0 format("%3d") //= "  0"
  β: 123456789 format("%3d") //= "123456789"
  γ: -10 format("%3d") //= "-10"
  δ: -123456789 format("%3d") //= "-123456789"
}

int-pads: {
  α: 0 format("%03d") //= "000"
  β: 1 format("%03d") //= "001"
  γ: 123456789 format("%03d") //= "123456789"
  δ: -10 format("%03d") //= "-10"
  ε: -123456789 format("%03d") //= "-123456789"
}

int-justs: {
  # At least five wide
  α: 10 format("%5d") //= "   10"
  # At least five-wide, left-justified
  β: 10 format("%-5d") //= "10   "
  # At least five-wide, zero-filled
  γ: 10 format("%05d") //= "00010"
  # At least five-wide, with a plus sign
  δ: 10 format("%+5d") //= "  +10"
  # Five-wide, plus sign, left-justified
  ε: 10 format("%-+5d") //= "+10  "
}

hex-ints: {
  α: 10 format("%x") //= "a"
  β: 10 format("%X") //= "A"
}

oct-ints: {
  α: 10 format("%o") //= "12"
}

float-fmts: {
  # Print one position after the decimal
  α: 10.3456 format("%.1f") //= "10.3"
  # Two positions after the decimal
  β: 10.3456 format("%.2f") //= "10.35"
  # Eight-wide, two positions after the decimal
  γ: 10.3456 format("%8.2f") //= "   10.35"
  # Eight-wide, four positions after the decimal
  δ: 10.3456 format("%8.4f") //= " 10.3456"
  # Eight-wide, two positions after the decimal, zero-filled
  ε: 10.3456 format("%08.2f") //= "00010.35"
  # Eight-wide, two positions after the decimal, left-justified
  ζ: 10.3456 format("%-8.2f") //= "10.35   "
  # Printing a much larger number with that same format
  η: 101234567.3456 format("%-8.2f") //= "101234567.35"
}

string-fmts: {
  # A simple string
  α: "Hello" format("%s") //= "Hello"
  # A string with a minimum length
  β: "Hello" format("%10s") //= "     Hello"
  # Minimum length, left-justified
  γ: "Hello" format("%-10s") //= "Hello     "
}

symbol: {
  # A simple string
  α: :Hello format("%s") //= "Hello"
  # A string with a minimum length
  β: :Hello format("%10s") //= "     Hello"
  # Minimum length, left-justified
  γ: :Hello format("%-10s") //= "Hello     "
}

a: 1
b: 1.5

fmt-interpolations: {
  α: "{a:%03d}" //= "001"
  β: "{b:%8.2f}" //= "    1.50"
  γ: "{a:%04d}-{b:%04f}" //= "0001-01.5"
}

x: 33
y: 44
bad-format(n): n format("%-8d") "***{}***"

fn-interpolations: {
  α: "{x:bad-format} -- {y:bad-format}" //= "***33      *** -- ***44      ***"
}

f: "{:%03d}{:%05x}"
g: "{1:%3.2f}{0:%5.2f}"
interpolations-with-anaphora: {
  a: f(200, 100) //= "20000064"
  b: g(1.1, 2.2) //= "2.20 1.10"
}

RESULT: [ int-widths
        , int-pads
        , int-justs
        , hex-ints
        , oct-ints
        , float-fmts
        , string-fmts
        , fmt-interpolations
        , fn-interpolations
        , interpolations-with-anaphora] mapcat(values) all-true? then(:PASS, :FAIL)
