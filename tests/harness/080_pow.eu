"pow(base, exp) — exponentiation."

tests: {
  int-base-cases: {
    a: pow(2, 0) //= 1
    b: pow(2, 1) //= 2
    c: pow(2, 10) //= 1024
    d: pow(10, 3) //= 1000
    e: pow(10, 0) //= 1
    f: pow(1, 100) //= 1
    g: pow(0, 5) //= 0
  }

  negative-base: {
    a: pow(-1, 2) //= 1
    b: pow(-1, 3) //= -1
    c: pow(-2, 3) //= -8
    d: pow(-3, 2) //= 9
  }

  negative-exponent: {
    a: pow(2, -1) //= 0.5
    b: pow(4, -1) //= 0.25
    c: pow(10, -2) //= 0.01
  }

  float-base: {
    a: pow(2.0, 3) //= 8.0
    b: pow(0.5, 2) //= 0.25
  }

  large-int: {
    a: pow(10, 10) //= 10000000000
  }

  int-range: {
    a: (2 ^ 62) str.of //= "4611686018427387904"
    b: ((-2) ^ 63) str.of //= "-9223372036854775808"
    c: (3 ^ 39) str.of //= "4052555153018976267"
    d: (1 ^ 9999999999) str.of //= "1"
    e: ((-1) ^ 9999999999) str.of //= "-1"
  }

  float-operand: {
    a: (2.0 ^ 62) str.of //= "4.611686018427388e+18"
    b: (2 ^ 62.0) str.of //= "4.611686018427388e+18"
  }
}

RESULT: tests values map(values) map(all-true?) all-true? then(:PASS, :FAIL)
