"Tests for set construction, membership, mutation, algebra, and rendering."

` "Construction"

construction-checks: {
  trues: [
    ([1, 2, 2, 3, 3, 3] set.from-list set.to-list) = [1, 2, 3],
    ([] set.from-list set.to-list) = [],
    (["c", "a", "b"] set.from-list set.to-list) = ["a", "b", "c"],
    ([42] set.from-list set.to-list) = [42],
    ([:a, :b, :a] set.from-list set.size) = 2
  ]
}

` "Empty set"

empty-checks: {
  trues: [
    (∅ set.to-list) = [],
    (∅ set.size) = 0,
    (∅ set.empty?) = true
  ]
}

` "Membership"

membership-checks: {
  trues: [
    ([1, 2, 3] set.from-list set.contains?(2)) = true,
    ([1, 2, 3] set.from-list set.contains?(4)) = false,
    (["a", "b"] set.from-list set.contains?("a")) = true,
    (∅ set.contains?(1)) = false,
    ([:a, :b, :c] set.from-list set.contains?(:b)) = true,
    # Non-primitive arguments return false, not panic (eu-sfil)
    ([1, 2] ∈ (set.from-list[1, 2, 3])) = false,
    ({x: 1} ∈ (set.from-list[:a])) = false,
    (null ∈ ∅) = false
  ]
}

` "Size"

size-checks: {
  trues: [
    ([1, 2, 3] set.from-list set.size) = 3,
    ([1, 1, 1] set.from-list set.size) = 1,
    (∅ set.size) = 0
  ]
}

` "Add and remove"

mutation-checks: {
  trues: [
    (∅ set.add(1) set.add(2) set.to-list) = [1, 2],
    ([1, 2] set.from-list set.add(1) set.size) = 2,
    ([1, 2, 3] set.from-list set.remove(2) set.to-list) = [1, 3],
    ([1, 2] set.from-list set.remove(9) set.to-list) = [1, 2]
  ]
}

` "Set algebra"

algebra-checks: {
  trues: [
    {
      a: [1, 2] set.from-list
      b: [2, 3] set.from-list
    }.(a set.union(b) set.to-list) = [1, 2, 3],
    {
      a: [1, 2, 3] set.from-list
      b: [2, 3, 4] set.from-list
    }.(a set.intersect(b) set.to-list) = [2, 3],
    {
      a: [1, 2] set.from-list
      b: [3, 4] set.from-list
    }.(a set.intersect(b) set.to-list) = [],
    {
      a: [1, 2, 3] set.from-list
      b: [2, 3] set.from-list
    }.(a set.diff(b) set.to-list) = [1],
    {
      a: [1, 2, 3] set.from-list
      b: [3] set.from-list
    }.(set.diff(b, a) set.to-list) = [1, 2],
    {
      a: [1, 2, 3] set.from-list
      b: [3] set.from-list
    }.(set.diff(a, b) set.to-list) = [],
    {
      a: [1, 2] set.from-list
    }.(a set.diff(∅) set.to-list) = [1, 2],
    {
      a: [1, 2] set.from-list
    }.(a set.union(∅) set.to-list) = [1, 2]
  ]
}

` "Round-trip and rendering"

render-checks: {
  trues: [
    {
      original: [3, 1, 2] set.from-list
      trip: original set.to-list set.from-list
    }.((original set.to-list) = (trip set.to-list)),
    ([3, 1, 2] set.from-list set.to-list) = [1, 2, 3],
    (["c", "a", "b"] set.from-list set.to-list) = ["a", "b", "c"],
    (∅ set.to-list) = [],
    {
      my-set: [1, 2, 3] set.from-list set.to-list
    } = {my-set: [1, 2, 3]},
    ([1, 2] set.from-list set.empty?) = false,
    ([1] set.from-list set.empty?) = false
  ]
}

` "Computed (thunk) elements — set.from-list must deep-force before extraction"

computed-checks: {
  trues: [
    (["a", "b", "c"] map("x-{}") set.from-list set.size) = 3,
    (["a", "b", "c"] map("x-{}") set.from-list set.contains?("x-a")) = true,
    ([1, 2, 3] map(+ 10) set.from-list set.to-list) = [11, 12, 13]
  ]
}

` "Membership operators ∈ and ∉"

operator-checks: {
  trues: [
    :a ∈ (set.from-list[:a, :b, :c]),
    not(:d ∈ (set.from-list[:a, :b])),
    :z ∉ (set.from-list[:a, :b]),
    not(:a ∉ (set.from-list[:a, :b])),
    1 ∈ (set.from-list[1, 2, 3]),
    "x" ∈ (set.from-list["x", "y"]),
    not(99 ∈ ∅)
  ]
}

` "Churn — rebuilt set storage spans many lines, and once collected its
blocks are reused for the next rebuild"

churn-checks: {
  rounds: 3000
  churn(s, i): s set.remove(i % 1000) set.add(i % 1000)
  done?(s, i): (i = rounds) ∨ ((s set.size) < 0)
  loop(s, i): done?(s, i) then(s, loop(churn(s, i), i + 1))
  final: loop(range(0, 1000) set.from-list, 0)
  trues: [
    (final set.size) = 1000,
    0 ∈ final,
    999 ∈ final,
    not(1000 ∈ final)
  ]
}

` "Exact integers — elements above 2^53 keep their identity and digits"

exact-checks: {
  big: 9007199254740992
  pair: [big, big + 1] set.from-list
  trues: [
    not((big + 1) ∈ (∅ set.add(big))),
    (∅ set.add(big) set.add(big + 1) set.size) = 2,
    (pair set.to-list) = [big, big + 1],
    (pair set.to-list map(str.of)) = ["9007199254740992", "9007199254740993"],
    (pair set.remove(big) set.to-list) = [big + 1],
    (pair set.union([big + 2] set.from-list) set.size) = 3,
    (pair set.intersect([big + 1] set.from-list) set.to-list) = [big + 1],
    (pair render-as(:json)) = ([big, big + 1] render-as(:json)),
    ([18446744073709551615, 18446744073709551614] set.from-list set.size) = 2,
    ([-9007199254740993, -9007199254740992] set.from-list set.size) = 2,
    ([1, 1.0, 2.5] set.from-list set.size) = 2
  ]
}

` "1 and 1.0 are one element; the integer form is kept, whatever the order of insertion or union"

representative-checks: {
  ints: [1, 2] set.from-list
  floats: [1.0, 2.0] set.from-list
  shown(s): s set.to-list map(str.of)
  trues: [
    ([1.0, 1] set.from-list shown) = ["1"],
    ([1, 1.0] set.from-list shown) = ["1"],
    (∅ set.add(1.0) set.add(1) shown) = ["1"],
    (∅ set.add(1) set.add(1.0) shown) = ["1"],
    (floats set.union(ints) shown) = ["1", "2"],
    (ints set.union(floats) shown) = ["1", "2"],
    (floats set.intersect(ints) shown) = ["1", "2"],
    (ints set.intersect(floats) shown) = ["1", "2"],
    ([[1.0, 2]] set.from-list set.add([1, 2.0]) set.to-list head map(str.of)) = ["1", "2.0"],
    (([1.0, 2] set.from-list set.union([1, 2.0] set.from-list)) render-as(:json)) = (([1, 2.0] set.from-list set.union([1.0, 2] set.from-list)) render-as(:json))
  ]
}

` "Sets on tree nodes (eu-oaz72.21) — add, remove and membership on larger
sets, symbols ordered by name, join-based algebra, fresh results and
rank-based sampling"

tree-checks: {
  n: 2000

  ` "multiples of 3 below 6000"
  big: range(0, n) map(* 3) set.from-list

  ` "multiples of 2 below 4000; the multiples of 6 below 4000 (667 of them) are shared with `big`"
  evens: range(0, n) map(* 2) set.from-list

  ` "`big` built by adding its elements one at a time, largest first"
  added: foldl(_0 set.add(_1), ∅, range(0, n) map(* 3) reverse)

  ` "`big` with every odd multiple of 3 removed"
  removed: foldl(_0 set.remove(_1), big, range(0, n) filter(_ % 2 = 1) map(* 3))

  ` "`:zz` is interned before `:aa`, so an order by intern id would differ from the order by name"
  first-zz: :zz

  mixed: [:zz, "b", 2, :aa, "a", 1.5, :mm] set.from-list

  ` "fifty elements drawn with the random monad"
  drawn: set.sample(50, big, random.stream(42)).value

  trues: [
    (big set.size) = n,
    (added set.size) = n,
    (removed set.size) = n / 2,
    (big set.add(3) set.size) = n,
    (big set.remove(1) set.size) = n,
    big set.contains?(5997),
    not(big set.contains?(5998)),
    not(removed set.contains?(3)),
    removed set.contains?(6),
    (added set.to-list) = (big set.to-list),
    (mixed set.to-list) = [1.5, 2, "a", "b", :aa, :mm, :zz],
    (mixed set.add(:bb) set.to-list) = [1.5, 2, "a", "b", :aa, :bb, :mm, :zz],
    (mixed set.remove(:mm) set.to-list) = [1.5, 2, "a", "b", :aa, :zz],
    (removed set.to-list take(3)) = [0, 6, 12],
    (big set.intersect(evens) set.size) = 667,
    (big set.intersect(evens) set.to-list take(3)) = [0, 6, 12],
    (big set.diff(evens) set.size) = n - 667,
    (big set.diff(evens) set.to-list take(3)) = [3, 9, 15],
    (evens set.diff(big) set.size) = n - 667,
    (big set.union(evens) set.size) = n + n - 667,
    (big set.union(∅) set.size) = n,
    (∅ set.intersect(big) set.size) = 0,
    (big set.diff(big) set.size) = 0,
    # `=` on sets is identity, and every operation returns a fresh set
    not((big set.add(3)) = big),
    not((big set.remove(1)) = big),
    not(∅ = (∅ set.add(1) set.remove(1))),
    (drawn set.size) = 50,
    (drawn set.diff(big) set.size) = 0,
    # fixed floats fix the draws of the partial Fisher-Yates over ranks:
    # [0.5, 0.5] picks rank 1000, then rank 1000 again, which the first
    # draw swapped with rank 0
    (big set.sample-raw([0.5, 0.0, 0.999, 0.25]) set.to-list) = [3, 1506, 3000, 5994],
    (big set.sample-raw([0.5, 0.5]) set.to-list) = [0, 3000],
    (big set.sample-raw(range(0, n + 5) map(-> 0.5)) set.size) = n,
    (∅ set.sample-raw([0.5]) set.size) = 0
  ]
}

` "List elements (eu-oaz72.21, design note OPEN 8): an element may be a list of elements, keyed as dict keys are; lists order after scalars, lexicographically"

list-checks: {

  ` "grid points as `[x, y]` pairs, with a duplicate and an element computed from thunks"
  points: [[2, 1], [1, 2], [1 + 0, 2], [0, 5]] set.from-list

  ` "a set mixing scalars, lists, an empty list and a nested list"
  mixed: [[1, [2]], :a, [], 3, [1, 2], "s"] set.from-list

  trues: [
    (points set.size) = 3,
    (points set.to-list) = [[0, 5], [1, 2], [2, 1]],
    points set.contains?([1, 2]),
    points set.contains?([2 * 1, 1]),
    not(points set.contains?([2, 2])),
    not(points set.contains?([1])),
    not(points set.contains?(1)),
    not(points set.contains?([1, {x: 1}])),
    ([0, 5] ∈ points),
    (points set.add([1, 1]) set.to-list) = [[0, 5], [1, 1], [1, 2], [2, 1]],
    (points set.add([1, 2]) set.size) = 3,
    (points set.add([3 - 1, 1]) set.size) = 3,
    (points set.remove([1, 2]) set.to-list) = [[0, 5], [2, 1]],
    (points set.remove([9, 9]) set.size) = 3,
    (foldl(_0 set.add(_1), ∅, [[1, 2], [0, 5], [2, 1], [0, 5]]) set.to-list) = (points set.to-list),
    (mixed set.to-list) = [3, "s", :a, [], [1, 2], [1, [2]]],
    mixed set.contains?([1, [2]]),
    not(mixed set.contains?([1, [3]])),
    (points set.union([[9, 9]] set.from-list) set.size) = 4,
    (points set.intersect([[1, 2], [7, 7]] set.from-list) set.to-list) = [[1, 2]],
    (points set.diff([[1, 2]] set.from-list) set.to-list) = [[0, 5], [2, 1]],
    (points render-as(:json) parse-as(:json)) = [[0, 5], [1, 2], [2, 1]]
  ]
}

` "Computed (non-literal) arguments to the hand-written set wrappers must be forced before use."
computed-arg-checks: {
  n(x): x + 0
  s: set.of[n(1), n(2)]
  trues: [
    s set.contains?(n(1)),
    (s set.add(n(3)) set.size) = 3,
    (s set.remove(n(1)) set.size) = 1,
    (s set.size) = 2
  ]
}

pass: [
  construction-checks.trues all-true?,
  empty-checks.trues all-true?,
  membership-checks.trues all-true?,
  size-checks.trues all-true?,
  mutation-checks.trues all-true?,
  algebra-checks.trues all-true?,
  render-checks.trues all-true?,
  computed-checks.trues all-true?,
  operator-checks.trues all-true?,
  churn-checks.trues all-true?,
  exact-checks.trues all-true?,
  representative-checks.trues all-true?,
  tree-checks.trues all-true?,
  list-checks.trues all-true?
  , computed-arg-checks.trues all-true?
] all-true?

RESULT: if(pass, :PASS, :FAIL)
