#!/usr/bin/env eu
{
  title: "292 dict: a stored value that refers back to itself"
  doc: "A lazy value stored in a dict is trimmed to the variables it reads
        (eu-oaz72.84). When those variables lead back to the value itself,
        the trimming must stop rather than recurse without bound (it once
        overflowed the stack). RESULT is computed from every check."
}

` "a list whose tail reads the list itself, through a second binding"
cyc-list(n): {
  xs: cons(n, ys)
  ys: xs map(+ 1)
  d: dict.empty dict.assoc(:k, xs)
}.d dict.get(:k) take(3)

` "a list whose second element reads the list's own head"
cyc-head(i): {
  xs: [i, (xs head) + 1]
  r: ((xs head) = i) then(dict.empty dict.assoc(:k, xs), dict.empty)
}.r dict.get(:k) tail head

` "the same value stored under two keys"
cyc-twice(n): {
  xs: cons(n, ys)
  ys: xs map(+ 1)
  d: dict.empty dict.assoc(:a, xs) dict.assoc(:b, xs)
}.d dict.get(:b) take(3)

` "how deep the stream is forced in the sharing gate"
stream-n: 20000

` "force the stream from `m`, `n` deep after storing it in a dict"
stream-stored(m, n): {
  xs: cons(m, ys)
  ys: xs map(+ 1)
  d: dict.empty dict.assoc(:k, xs)
}.d dict.get(:k) take(n) last

` "force the same stream from `m`, `n` deep with no dict"
stream-plain(m, n): {
  xs: cons(m, ys)
  ys: xs map(+ 1)
}.xs take(n) last

` { target: :stream-stored-run }
stream-stored-run: stream-stored(1, stream-n) = stream-n

` { target: :stream-plain-run }
stream-plain-run: stream-plain(1, stream-n) = stream-n

list-ok: cyc-list(1) = [1, 2, 3]
head-ok: cyc-head(3) = 4
twice-ok: cyc-twice(5) = [5, 6, 7]

RESULT: [list-ok, head-ok, twice-ok, stream-stored-run, stream-plain-run] all-true? then(:PASS, :FAIL)
