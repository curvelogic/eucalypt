#!/usr/bin/env eu
{
  title: "303 str.reverse and merge-intervals"
  doc: "Owner decision 43 (eu-oaz72.26). merge-intervals treats intervals as
        closed integer intervals (owner decision 46): they merge when
        lo2 <= hi1 + 1, so [1, 3] merges with [3, 5] and with the adjacent
        [4, 6], but not with [5, 6]. RESULT is computed from every check."
}

` "str.reverse"
reverse-checks: [
  str.reverse("hello") = "olleh",
  str.reverse("") = "",
  str.reverse("a") = "a",
  str.reverse("héllo") = "olléh",
  str.reverse("日本語") = "語本日",
  ("abc" str.reverse) = "cba",
  str.reverse(str.reverse("round trip")) = "round trip"
]

` "merge-intervals"
interval-checks: [
  merge-intervals([]) = [],
  merge-intervals([[1, 2]]) = [[1, 2]],
  merge-intervals([[5, 7], [1, 3], [2, 4]]) = [[1, 7]],
  merge-intervals([[6, 7], [1, 3], [2, 4]]) = [[1, 4], [6, 7]],
  merge-intervals([[1, 3], [3, 5]]) = [[1, 5]],
  merge-intervals([[1, 3], [4, 6]]) = [[1, 6]],
  merge-intervals([[1, 3], [5, 6]]) = [[1, 3], [5, 6]],
  merge-intervals([[5, 6], [1, 3], [4, 4]]) = [[1, 6]],
  merge-intervals([[1, 10], [2, 3], [4, 5]]) = [[1, 10]],
  merge-intervals([[1, 5], [2, 3], [4, 9], [20, 21]]) = [[1, 9], [20, 21]],
  merge-intervals([[2, 2], [1, 1], [2, 2]]) = [[1, 2]],
  merge-intervals([[1, 1], [3, 3]]) = [[1, 1], [3, 3]],
  merge-intervals([[1, 3], [1, 2]]) = [[1, 3]],
  merge-intervals([[-5, -1], [-3, 2]]) = [[-5, 2]]
]

RESULT: [reverse-checks, interval-checks] concat all-true? then(:PASS, :FAIL)
