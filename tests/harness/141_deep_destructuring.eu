"141 deep nested destructuring — lists and blocks at arbitrary depth"

` { target: :test }
test: {
  # Two-level list: [a, [b, c]] (already worked before, regression check)
  two-level([ a, [b, c] ]): [a, b, c]
  two-level-ok: two-level([1, [2, 3]]) //= [1, 2, 3]

  # Three-level list: [a, [b, [c, d]]]
  three-level([a, [b, [c, d]]]): [a, b, c, d]
  three-level-ok: three-level([1, [2, [3, 4]]]) //= [1, 2, 3, 4]

  # Head/tail with nested head: [[a, b] : rest]
  nested-head([[a, b] : rest]): [a, b, rest count]
  nested-head-ok: nested-head([[10, 20], 30, 40]) //= [10, 20, 2]

  # Block with simple field rename (regression check)
  simple-block({x y}): [x, y]
  simple-block-ok: simple-block({x: 1, y: 2}) //= [1, 2]

  # Block with nested list value: {field: [a, b]}
  block-list({data: [a, b]}): [a, b]
  block-list-ok: block-list({data: [7, 8]}) //= [7, 8]

  # Block nested inside block: {outer: {inner}}
  block-block({outer: {inner}}): inner
  block-block-ok: block-block({outer: {inner: 99}}) //= 99

  # List containing a block: [{x y}, z]
  list-block([{x y}, z]): [x, y, z]
  list-block-ok: list-block([{x: 10, y: 20}, 30]) //= [10, 20, 30]

  # Block with list nested inside renamed block: {a: {b: [p, q]}}
  triple-nested({a: {b: [p, q]}}): [p, q]
  triple-nested-ok: triple-nested({a: {b: [5, 6]}}) //= [5, 6]

  ` "Juxtaposed list pattern with a nested list: f[a, [b, c]]"
  jux-nested[a, [b, c]]: [a, b, c]
  jux-nested-ok: jux-nested[1, [2, 3]] //= [1, 2, 3]

  ` "Juxtaposed list pattern with `_` placeholders and a nested list"
  jux-underscore[_, [bit, _]]: bit
  jux-underscore-ok: jux-underscore[0, [5, 6]] //= 5

  ` "Juxtaposed list pattern nested three deep"
  jux-deep[a, [b, [c, d]]]: [a, b, c, d]
  jux-deep-ok: jux-deep[1, [2, [3, 4]]] //= [1, 2, 3, 4]

  ` "Juxtaposed cons pattern with a nested list head: f[[a, b] : rest]"
  jux-cons-head[[a, b] : rest]: [a, b, rest count]
  jux-cons-head-ok: jux-cons-head[[10, 20], 30, 40] //= [10, 20, 2]

  ` "Juxtaposed list pattern with a nested cons pattern: f[a, [b : t]]"
  jux-nested-cons[a, [b : t]]: [a, b, t count]
  jux-nested-cons-ok: jux-nested-cons[1, [2, 3, 4]] //= [1, 2, 2]

  ` "Juxtaposed list pattern with a nested block pattern"
  jux-block[{x y}, z]: [x, y, z]
  jux-block-ok: jux-block[{x: 1, y: 2}, 3] //= [1, 2, 3]

  RESULT: [ two-level-ok
          , three-level-ok
          , nested-head-ok
          , simple-block-ok
          , block-list-ok
          , block-block-ok
          , list-block-ok
          , triple-nested-ok
          , jux-nested-ok
          , jux-underscore-ok
          , jux-deep-ok
          , jux-cons-head-ok
          , jux-nested-cons-ok
          , jux-block-ok
          ] all-true? then(:PASS, :FAIL)
}
