# eu-1tkk.7.38: an under-applied call used as an operand.
#
# Catenation binds more loosely than `+`, so this parses as
# `xs (foldl(+, 0) + 1)` and `+` is handed the partial application
# `foldl(+, 0)`.  The primary label is the eleven columns of `foldl(+, 0)`:
# the operand's own annotation is carried with the error (eu-oaz72.121), so it
# no longer depends on the machine's annotation register, which since
# eu-oaz72.63 holds the failing `+` instead.
xs: [1, 2, 3]
n: xs foldl(+, 0) + 1
