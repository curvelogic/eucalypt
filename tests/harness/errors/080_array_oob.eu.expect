# operation entirely. Pinned on the `┌─` line; holds in both prelude modes
# and on both engines.
exit: 1
stderr: "(?s)array index out of bounds: coordinates .* are outside the array bounds.*┌─[^\n]*080_array_oob\.eu:2:40"
