# The same u64-above-i64::MAX value that broke YAML export also reached an
# `unreachable!` in the TOML exporter, since TOML integers are signed 64-bit
# too. Both now raise EU-RENDER-UNREPRESENTABLE (eu-1tkk.7.20).
#
# Anchored on the primary-label line ('┌─ …:4:12') rather than the
# 'stack trace:' note, so losing the label fails the test.
exit: 1
stderr: "(?s)error\[EU-RENDER-UNREPRESENTABLE\].*cannot represent this value in TOML output: the integer 9999999999999999999 is above 9223372036854775807, the largest integer a TOML integer can carry.*┌─[^\n]{0,8}194_toml_large_uint\.eu:4:12"
