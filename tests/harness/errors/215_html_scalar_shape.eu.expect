# exit: 1 is load-bearing in the opposite direction to 195: the pre-fix
# behaviour here was exit 0 with empty output, so the exit assertion is
# what turns "silently rendered nothing" into a failure.
#
# No location assertion, for the same reason as 195 — see that sidecar.
exit: 1
stderr: "(?s)error\[EU-RENDER-SHAPE\].*cannot render this document as html: the value to render is a single scalar, but markup output needs a hiccup element"
