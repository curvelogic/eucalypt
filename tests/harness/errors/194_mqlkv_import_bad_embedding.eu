{ import: "testdata/194_mqlkv_bad_annotation.eu" }

# eu-mqlkv, site 1 of 3 — the `Unit` impl's unit-metadata import loop
# (rowan_ast.rs, `impl Desugarable for rowan_ast::Unit`).
#
# An invalid embedding in an IMPORTED unit used to abort the process with
# exit 101 via `.expect("failure translating import")`, while the same file
# evaluated directly produced a clean diagnostic. It must now produce the
# diagnostic either way.
r: f(1)
