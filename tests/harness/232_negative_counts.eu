{ doc: "Counts at or below zero in `take`, `drop`, `split-at`, `rotate` and `range` terminate and behave consistently, including on infinite lists (eu-oaz72.35, eu-oaz72.43). `nth` and `update-nth` with a negative index are errors: see tests/harness/errors/233_*_negative.eu." }

` { target: :test-range-take
    doc: "eu-oaz72.35: `take(n, l)` stopped only when the count reached exactly zero, so a negative count never stopped and a reversed `range(b, e)` hung. Now `take(n)` with n <= 0 is [] and `range(b, e)` with e <= b is []. Checks that would force an infinite list on the old code are bounded, so with the bug present they fail rather than hang." }
test-range-take: {
  ` "Count of the inclusive range from the first to the second bound."
  span(bounds): range(bounds first, (bounds second) + 1) take(100) count

  checks: {
    reversed-range: range(10, 9) nil?
    empty-range: range(5, 5) nil?
    far-reversed-range: range(0, -1000) nil?
    forward-range: range(3, 6) = [3, 4, 5]
    negative-forward-range: range(-2, 1) = [-2, -1, 0]
    reversed-range-count: (range(10, 9) take(100) count) = 0

    take-negative-finite: ([1, 2, 3] take(-1)) = []
    take-zero-finite: ([1, 2, 3] take(0)) = []
    take-negative-infinite: ints-from(0) take(-1) nil?
    take-zero-infinite: ints-from(0) take(0) nil?
    take-positive-infinite: (ints-from(0) take(3)) = [0, 1, 2]
    take-beyond-finite: ([1, 2] take(5)) = [1, 2]

    ` "Reversed bounds in a computed range are skipped, not looped over (the
      shape of the AoC 2025 day 10 part 2 inner search)."
    skipped: ([[1, 5], [7, 3], [4, 4]] map(span)) = [5, 0, 1]
  }

  RESULT: checks values all-true? then(:PASS, :FAIL)
}

` { target: :test-negative-counts
    doc: "eu-oaz72.43: after `take` stopped at n <= 0, `drop`, `split-at` (and so `rotate`) still stopped only at exactly zero. Now n <= 0 makes `drop` the identity, `split-at` return [[], l] and `rotate` the identity. Checks on infinite lists are bounded by `take`." }
test-negative-counts: {
  checks: {
    drop-negative-finite: ([1, 2, 3] drop(-1)) = [1, 2, 3]
    drop-zero-finite: ([1, 2, 3] drop(0)) = [1, 2, 3]
    drop-positive-finite: ([1, 2, 3] drop(2)) = [3]
    drop-negative-infinite: (ints-from(0) drop(-2) take(3)) = [0, 1, 2]
    drop-positive-infinite: (ints-from(0) drop(2) take(2)) = [2, 3]

    split-at-negative-finite: ([1, 2, 3] split-at(-1)) = [[], [1, 2, 3]]
    split-at-zero-finite: ([1, 2, 3] split-at(0)) = [[], [1, 2, 3]]
    split-at-positive-finite: ([1, 2, 3] split-at(1)) = [[1], [2, 3]]
    split-at-negative-infinite-prefix: ints-from(0) split-at(-3) first nil?
    split-at-negative-infinite-suffix: (ints-from(0) split-at(-3) second take(2)) = [0, 1]

    rotate-negative: ([1, 2, 3] rotate(-1)) = [1, 2, 3]
    rotate-positive: ([1, 2, 3] rotate(1)) = [2, 3, 1]

    nth-zero-infinite: (ints-from(5) nth(0)) = 5
    nth-positive: ([1, 2, 3] nth(2)) = 3
    update-nth-zero: ([1, 2, 3] update-nth(0, inc)) = [2, 2, 3]
    update-nth-positive: ([1, 2, 3] update-nth(2, inc)) = [1, 2, 4]
  }

  RESULT: checks values all-true? then(:PASS, :FAIL)
}
