#!/usr/bin/env eu
# eu-oaz72.43: after eu-oaz72.35 made `take(n)` stop at n <= 0, `drop`,
# `split-at` (and so `rotate`) still stopped only when the count reached
# exactly zero. A negative count never stopped: `drop(-1)` never terminated,
# `split-at(-1)` split at the end of a finite list and never terminated on an
# infinite one.
#
# Fixed: n <= 0 makes `drop` the identity, `split-at` return [[], l] and
# `rotate` the identity. `nth` with a negative index is an error (covered by
# tests/harness/errors/233_oaz72_43_nth_negative_infinite.eu).
#
# Every check feeds RESULT. Checks on infinite lists are bounded by
# `take`, so with the bug present they fail rather than hang where possible.

checks: {
  drop-negative-finite: ([1, 2, 3] drop(-1)) = [1, 2, 3]
  drop-zero-finite: ([1, 2, 3] drop(0)) = [1, 2, 3]
  drop-positive-finite: ([1, 2, 3] drop(2)) = [3]
  drop-negative-infinite: (ints-from(0) drop(-2) take(3)) = [0, 1, 2]
  drop-positive-infinite: (ints-from(0) drop(2) take(2)) = [2, 3]

  split-at-negative-finite: ([1, 2, 3] split-at(-1)) = [[], [1, 2, 3]]
  split-at-zero-finite: ([1, 2, 3] split-at(0)) = [[], [1, 2, 3]]
  split-at-positive-finite: ([1, 2, 3] split-at(1)) = [[1], [2, 3]]
  split-at-negative-infinite-prefix: ints-from(0) split-at(-3) first nil?
  split-at-negative-infinite-suffix: (ints-from(0) split-at(-3) second take(2)) = [0, 1]

  rotate-negative: ([1, 2, 3] rotate(-1)) = [1, 2, 3]
  rotate-positive: ([1, 2, 3] rotate(1)) = [2, 3, 1]

  nth-zero-infinite: (ints-from(5) nth(0)) = 5
  nth-positive: ([1, 2, 3] nth(2)) = 3
}

RESULT: if(checks values all-true?, :PASS, :FAIL)
