#!/usr/bin/env eu


(l + r): __ADD(l, r)
(l - r): __SUB(l, r)
(l * r): __MUL(l, r)
(l / r): __DIV(l, r)
(l ÷ r): __PDIV(l, r)
(l % r): __MOD(l, r)

(l > r): __GT(l, r)
(l < r): __LT(l, r)
(l >= r): __GTE(l, r)
(l <= r): __LTE(l, r)

integer-arithmetic: {
  trues: {
    a: 4 > 2
    b: 2 < 4
    c: 2 <= 4
    d: 2 <= 2
    e: 4 >= 2
    f: 2 >= 2
  }

  falses: {
    a: 4 < 2
    b: 2 > 4
    c: 2 >= 4
    d: 3 <= 2
    e: 4 <= 2
    f: 1 >= 2
  }

  true-calcs: {
    four: 2 + 2 //= 4
    also-four: 2 * 2 //= 4
    three: 5 - 2 //= 3
    twelve: 24 / 2 //= 12
    two: 5 % 3 //= 2
    floor-neg: -7 / 2 //= -4
    floor-mod-neg: -7 % 3 //= 2
  }

  pass: (trues values all-true?) ∧ (falses values map(not) all-true?) ∧ (true-calcs values all-true?)
}

floating-point-arithmetic: {
  trues: {
    a: 4.0 > 2.0
    b: 2.0 < 4.0
    c: 2.0 <= 4.0
    d: 2.0 <= 2.0
    e: 4.0 >= 2.0
    f: 2.0 >= 2.0
  }

  falses: {
    a: 4.0 < 2.0
    b: 2.0 > 4.0
    c: 2.0 >= 4.0
    d: 3.0 <= 2.0
    e: 4.0 <= 2.0
    f: 1.0 >= 2.0
  }

  vals: {
    fourish: (2.01 + 2.01) - 4 < 0.1
    also-fourish: (2.01 * 2.01) - 4 < 0.1
    threeish: (5.01 - 2.01) - 3 < 0.1
    twelveish: (24.01 ÷ 2.01) - 12 < 0.1
  }

  pass: (trues values all-true?) ∧ (falses values map(not) all-true?) ∧ (vals values all-true?)
}

mixed-arithmetic: {
  trues: {
    a: 4 > 2.0
    b: 2 < 4.0
    c: 2 <= 4.0
    d: 2 <= 2.0
    e: 4 >= 2.0
    f: 2 >= 2.0
  }

  falses: {
    a: 4 < 2.0
    b: 2 > 4.0
    c: 2 >= 4.0
    d: 3 <= 2.0
    e: 4 <= 2.0
    f: 1 >= 2.0
  }

  trues2: {
    a: 4.0 > 2
    b: 2.0 < 4
    c: 2.0 <= 4
    d: 2.0 <= 2
    e: 4.0 >= 2
    f: 2.0 >= 2
  }

  falses2: {
    a: 4.0 < 2
    b: 2.0 > 4
    c: 2.0 >= 4
    d: 3.0 <= 2
    e: 4.0 <= 2
    f: 1.0 >= 2
  }

  vals: {
    fourish: (2.01 + 2) - 4 < 0.1
    also-fourish: (2.01 * 2) - 4 < 0.1
    threeish: (5.01 - 2) - 3 < 0.1
    twelveish: (24.01 ÷ 2) - 12 < 0.1
  }

  pass: ((trues values) ++ (trues2 values) all-true?) ∧
        ((falses values) ++ (falses2 values) map(not) all-true?) ∧
        (vals values all-true?)
}

divisibility: {
  trues: {
    divides: 3 ∣ 12
    divides-self: 7 ∣ 7
    zero-dividend: 4 ∣ 0
    negative-divisor: -3 ∣ 12
    negative-dividend: 3 ∣ -12
    not-divides: 5 ∤ 12
    not-divides-negative: -5 ∤ 12
  }

  falses: {
    reversed: 12 ∣ 3
    non-multiple: 5 ∣ 12
    not-divides-multiple: 3 ∤ 12
    not-divides-zero-dividend: 4 ∤ 0
  }

  precedence: {
    sum-and-product: 1 + 2 ∣ 3 * 4
    with-and: 2 ∣ 4 ∧ 3 ∤ 4
    with-or: 5 ∣ 4 ∨ 2 ∣ 4
    left-assoc-with-eq: 2 ∣ 4 = true
  }

  pipelines: {
    multiples: [1, 2, 3, 4, 5, 6, 7, 8, 9] filter(3 ∣ _) //= [3, 6, 9]
    odds: [1, 2, 3, 4, 5] filter(2 ∤ _) //= [1, 3, 5]
  }

  pass: (trues values all-true?) ∧
        (falses values map(not) all-true?) ∧
        (precedence values all-true?) ∧
        (pipelines values all-true?)
}

RESULT: (integer-arithmetic.pass ∧ floating-point-arithmetic.pass ∧ mixed-arithmetic.pass ∧ divisibility.pass) then(:PASS, :FAIL)
