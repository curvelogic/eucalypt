# Idiomatic code must be clean under `eu check --strict` (eu-oaz72.168).
# interleave accepts lists of differing element types, and parse-as is
# dynamically typed so its result can be passed to list functions.
mixed: interleave([1, 2, 3], [:a, :b])
parsed: "[1, 2, 3]" parse-as(:json)
first-val: parsed head
n: parsed count
