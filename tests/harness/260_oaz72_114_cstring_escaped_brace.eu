#!/usr/bin/env eu
# eu-oaz72.114: in a c-string, an escaped brace (`\{` or `\}`) at the
# start of a literal run was split from its backslash by the c-string
# pattern lexer, so the brace was read as an unescaped one. `c"\{ {n}"`
# failed with "invalid c-string escape: unexpected end of string in
# escape", and so did `c"\{lit}"` and `c"\}"`.
#
# Each check is a direct comparison and RESULT is computed from all of
# them, so every case gates the build. Expected values are plain
# strings, which escape braces by doubling them.

n: 1

t1: c"\{ {n}" = "{{ 1"
t2: c"\{lit}" = "{{lit}}"
t3: c"\{{n}\}" = "{{1}}"
t4: c"\}" = "}}"
t5: c"\{" = "{{"
t6: c"a\{b" = "a{{b"
t7: c"{n} \}" = "1 }}"
t8: c"{n}\{{n}" = "1{{1"
t9: c"\\{n}" = c"\\1"

RESULT: [t1, t2, t3, t4, t5, t6, t7, t8, t9] all-true? then(:PASS, :FAIL)
