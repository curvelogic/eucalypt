{ import: "resource:do"
  doc: "191 EF1 combined effect monad (do): one colon-do block threading a
        state-and-seed context over IO across all three effects, with parity
        against the underlying state and random monads run directly." }

# Fixed seed stream so the random draw is deterministic and can be checked
# for parity against the random monad run directly.
` :suppress
seed0: random.stream(42)

` :suppress
ctx0: { state: { count: 0 }, seed: seed0 }

# One pipeline exercising io (shell), state (put / modify / %! lens operator),
# random (float), and a pure step — all as native do.* actions.
` :suppress
pipeline: { :do
  greeting: do.shell("echo hi")
  _:        do.put(:echoed, greeting.stdout)
  _:        do.modify(:count, (+ 1))
  _:        do.st(:count %! (+ 9))
  r:        do.float
  n:        do.query(_.count)
  _:        do.pure(:ignored)
}.([greeting.stdout, r, n])

# The same state effect run through the state monad directly (parity).
` :suppress
state-chain: { :state
  _: state.modify(:count, (+ 1))
  _: :count %! (+ 9)
}.(:done)

# Build the PASS/FAIL verdict from the do-run result.
` :suppress
verdict(res): {
  stdout-value:    (res.value head) = c"hi\n"
  count-threaded:  res.ctx.state.count = 10
  echoed-threaded: res.ctx.state.echoed = c"hi\n"
  query-matches:   (res.value nth(2)) = 10
  rand-parity:     (res.value nth(1)) = random.eval(random.float, seed0)
  state-parity:    (state.run(state-chain, { count: 0 }).state.count) = 10

  RESULT: [stdout-value, count-threaded, echoed-threaded,
           query-matches, rand-parity, state-parity]
    all-true? then(:PASS, :FAIL)
}

` { target: :test }
test: do.run(pipeline, ctx0) io.map(verdict)
