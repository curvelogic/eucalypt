#!/usr/bin/env eu
# eu-oaz72.32: `set.of` and `vec.of` are the primary list-to-collection
# constructors, each a one-pass bulk intrinsic, with `set.from-list` and
# `vec.from-list` as aliases. `set.from-list` used to be a prelude fold of
# `set.add`, quadratic because each add copies the set.

xs: [3, 1, 2.5, 3, :x, "b", 1, "a", :a, -4]

# Reference: the old definition, a fold of `set.add` from the empty set.
by-fold: foldl({s: • e: •}.(s set.add(e)), ∅, xs) set.to-list

# set.of sorts and removes duplicates, as the fold did
t1: (xs set.of set.to-list) = by-fold
t2: ([5, 5, 4, 4, 3] set.of set.to-list) = [3, 4, 5]
t3: (["b", "a", "b"] set.of set.to-list) = ["a", "b"]
t4: ([] set.of set.size) = 0
t5: ([] set.of set.empty?)

# set.from-list is the same function as set.of
t6: (xs set.from-list set.to-list) = (xs set.of set.to-list)
t7: ([] set.from-list set.size) = 0
t8: (2 ∈ set.from-list([1, 2])) ∧ (2 ∉ set.of([1, 3]))

# The result is an ordinary set: the other set operations accept it
t9: (set.union(set.of([1, 2]), set.from-list([2, 3])) set.to-list) = [1, 2, 3]
t10: (set.of([1, 2]) set.add(0) set.to-list) = [0, 1, 2]

# Bulk construction stays fast at size (the fold took seconds at 20000)
t11: (range(0, 100000) set.of set.size) = 100000
t12: (range(0, 100000) map(_ % 7) set.from-list set.size) = 7

# select / dissoc build their key sets with set.from-list
t13: ({a: 1 b: 2 c: 3} select([:a, :c]) keys) = [:a, :c]
t14: ({a: 1 b: 2 c: 3} dissoc([:a, :c]) keys) = [:b]

# vec.from-list is the same function as vec.of
v: [10, 20, 30] vec.from-list
t15: (v vec.len) = 3
t16: [v vec.nth(0), v vec.nth(1), v vec.nth(2)] = [10, 20, 30]
t17: ([] vec.from-list vec.len) = 0
ys: ["a", :b, 1, 2.5]
t18: (ys vec.from-list vec.nth(0)) = (ys vec.of vec.nth(0))

RESULT: if([t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11, t12, t13, t14, t15, t16, t17, t18] all-true?, :PASS, :FAIL)
