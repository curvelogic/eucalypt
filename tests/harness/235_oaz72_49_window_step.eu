#!/usr/bin/env eu
# eu-oaz72.49: `window(n, step, l)` and `window-all(n, step, l)` with
# step <= 0 never terminated (the stride never advanced through the list),
# and `window` with size n <= 0 produced an infinite list of [] even on a
# finite list.
#
# Fixed: a step that is not positive is an error for both, and so is a
# size that is not positive for `window`
# (tests/harness/errors/235_oaz72_49_*.eu). `window-all` with size <= 0
# already gave [] (whatever the step) and still does, so `partition-all(n)`
# with n <= 0 is still []. Positive arguments behave as before,
# including `window` on infinite lists (bounded by `take`).

checks: {
  window-step-1: ([1, 2, 3, 4] window(2, 1)) = [[1, 2], [2, 3], [3, 4]]
  window-step-2: ([1, 2, 3, 4, 5] window(2, 2)) = [[1, 2], [3, 4]]
  window-step-gt-size: ([1, 2, 3, 4, 5, 6] window(2, 3)) = [[1, 2], [4, 5]]
  window-short: ([1] window(2, 1)) nil?
  window-infinite: (ints-from(0) window(3, 2) take(2)) = [[0, 1, 2], [2, 3, 4]]
  partition-even: ([1, 2, 3, 4] partition(2)) = [[1, 2], [3, 4]]
  over-sliding-pairs-ok: ([1, 3, 6] over-sliding-pairs(-)) = [-2, -3]

  window-all-step-1: ([1, 2, 3] window-all(2, 1)) = [[1, 2], [2, 3], [3]]
  window-all-step-2: ([1, 2, 3, 4, 5] window-all(2, 2)) = [[1, 2], [3, 4], [5]]
  partition-all-ok: ([1, 2, 3] partition-all(2)) = [[1, 2], [3]]
  window-all-size-zero: ([1, 2, 3] window-all(0, 1)) nil?
  window-all-size-negative: ([1, 2, 3] window-all(-1, 1)) nil?
  window-all-size-zero-step-zero: ([1, 2, 3] window-all(0, 0)) nil?
  window-all-size-negative-step-zero: ([1, 2, 3] window-all(-1, 0)) nil?
  partition-all-zero: ([1, 2, 3] partition-all(0)) nil?
  partition-all-negative: ([1, 2, 3] partition-all(-2)) nil?
}

RESULT: if(checks values all-true?, :PASS, :FAIL)
