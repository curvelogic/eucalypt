#!/usr/bin/env eu
# eu-oaz72.55: large objects (allocations of a GC block or more) were never
# freed, so large-object churn leaked without bound. Each `arr.set` on a
# 100x100 array copies its 10,000-element storage into a new large object
# and drops the old one.
#
# This file gates that the churn computes the right answer and that a large
# object live across the churn survives intact, under whatever collections
# the churn triggers (and under EU_GC_VERIFY / EU_GC_POISON / EU_GC_STRESS
# in CI's GC-verification job). tests/large_object_churn_test.rs runs it
# under a small heap limit and gates that the dead large objects are freed.

# A large object that stays live across the churn
`{ export: :suppress }
keep: arr.fill([100, 100], 7)

step(a, i): a arr.set([i % 100, 0], i)

`{ export: :suppress }
churned: foldl(step, arr.zeros([100, 100]), range(0, 3000))

# Column 0 ends holding 2900..2999; everything else stays 0
t1: (churned arr.get([99, 0])) = 2999
t2: (churned arr.get([0, 0])) = 2900
t3: (churned arr.to-list sum) = 294950
t4: (churned arr.get([50, 50])) = 0

# The large object held across the churn is intact
t5: (keep arr.to-list sum) = 70000
t6: (keep arr.get([99, 99])) = 7

RESULT: if([t1, t2, t3, t4, t5, t6] all-true?, :PASS, :FAIL)
