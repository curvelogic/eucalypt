{ import: "contract.eu"
  doc: "SV3 eu-u9xj.1 - validate reports located violations.

match? answers one bit; for an imported manifest one bit is close to useless.
validate walks spec and value together, carrying a path, and emits an entry
for every mismatch it finds." }

##
## Conformance - an empty list means the data conforms
##

t1: ({ a: 1 } validate(s"{a: number}")) nil?
t2: ([1, 2, 3] validate(s"[number]")) nil?
t3: ("x" validate(s"string")) nil?
t4: ({ a: 1, b: "x" } validate(s"{a: number, ..}")) nil?
t5: ({ host: "x" } validate(s"{host: string, port?: number}")) nil?
t6: ({ host: "x", port: 80 } validate(s"{host: string, port?: number}")) nil?
t7: ([1, "x"] validate(s"(number, string)")) nil?
t8: (42 validate(s"number | string")) nil?
t9: (null validate(s"number?")) nil?
t10: ({ a: { b: 1 } } validate(s"{a: {b: number}}")) nil?
t11: (:sym validate(s"symbol")) nil?
t12: (true validate(s"bool")) nil?
t13: (null validate(s"null")) nil?
t14: ([1, "a", "b"] validate(s"[number, string…]")) nil?
t15: (map validate(s"number → number")) nil?

# `any`, `top` and type variables are unconstrained at runtime.
t16: (:anything validate(s"any")) nil?
t17: (:anything validate(s"top")) nil?
t18: (:anything validate(s"a")) nil?

# `never` is inhabited by nothing.
t19: ((42 validate(s"never")) count) = 1

##
## :type-mismatch
##

` :suppress
m: { a: "wrong" } validate(s"{a: number}")

t20: (m count) = 1
t21: (m first).path = "a"
t22: (m first).kind = :type-mismatch
t23: (m first).expected = "number"
t24: (m first).found = "string"

##
## :missing - the path points at the CONTAINING record
##

` :suppress
mi: { } validate(s"{a: number}")

t25: (mi count) = 1
t26: (mi first).path = ""
t27: (mi first).kind = :missing
t28: (mi first).expected = "a"
t29: (mi first).found = :absent

##
## :unexpected - closed records only
##

` :suppress
un: { a: 1, b: 2 } validate(s"{a: number}")

t30: (un count) = 1
t31: (un first).kind = :unexpected
t32: (un first).expected = :closed
t33: (un first).found = [:b]

# The same data against an open spec has no :unexpected entry. This is the
# whole observable effect of carrying closedness through the projection.
t34: ({ a: 1, b: 2 } validate(s"{a: number, ..}")) nil?
t35: ({ a: 1, b: 2 } validate(s"{a: number, ..r}")) nil?

##
## :length
##

` :suppress
ln: [1] validate(s"(number, string)")

t36: (ln count) = 1
t37: (ln first).kind = :length
t38: (ln first).expected = 2
t39: (ln first).found = 1

# A tuple arity mismatch terminates the subtree - no element violations.
` :suppress
ln2: ["a", "b", "c"] validate(s"(number, number)")
t40: (ln2 count) = 1

# A prefix-list shorter than its prefix is a :length violation.
` :suppress
ln3: [1] validate(s"[number, string, bool…]")
t41: (ln3 count) = 1
t42: (ln3 first).kind = :length
t43: (ln3 first).expected = 2

##
## Accumulation - ALL violations, not the first
##

` :suppress
acc: { a: "x", c: 1 } validate(s"{a: number, b: string}")

t44: (acc count) = 3
t45: (acc map(kind-of)) = [:type-mismatch, :missing, :unexpected]

kind-of(v): v.kind

##
## Ordering - depth-first in spec order, fields then the :unexpected entry
##

t46: (acc first).path = "a"
t47: (acc second).expected = "b"
t48: (acc !! 2).kind = :unexpected

##
## Paths
##

` :suppress
deep: { servers: [{ host: "a", port: 1 }, { host: "b", port: "no" }] }
        validate(s"{servers: [{host: string, port: number}]}")

t49: (deep count) = 1
t50: (deep first).path = "servers[1].port"

# A key that would not lex as a bare identifier is quoted in the path. The
# type DSL has no quoted-key syntax, so the spec is written as t-* data.
` :suppress
odd-spec: [:t-record, { 'my key': [:t-field, :required, [:t-prim, :string]] }, false]

` :suppress
quoted: block([[:'my key', 1]]) validate(odd-spec)

t51: (quoted first).path = "'my key'"

# The root path is the empty string.
t52: ((42 validate(s"string")) first).path = ""

##
## Unions report ONE violation at the union's own path
##

` :suppress
u: :sym validate(s"number | string")
t53: (u count) = 1
t54: (u first).expected = "number | string"
t55: (u first).path = ""

##
## A container mismatch terminates that subtree
##

` :suppress
notblk: "hello" validate(s"{a: number, b: number}")
t56: (notblk count) = 1
t57: (notblk first).kind = :type-mismatch
t58: (notblk first).found = "string"
t59: (notblk first).expected = "{{a: number, b: number}}"

##
## Optional fields - absent is conformant, present must match
##

` :suppress
opt: { host: "x", port: "80" } validate(s"{host: string, port?: number}")
t60: (opt count) = 1
t61: (opt first).path = "port"
t62: (opt first).kind = :type-mismatch

##
## Agreement with the shipped as-spec / match? chain
##
## Record specs are excluded unless open: as-spec matches openly by design,
## so a CLOSED spec legitimately disagrees with match? on surplus keys.
##

agrees(spec, v): ((v validate(spec)) nil?) = (v match?(spec as-spec))

t63: agrees(s"{a: number, ..}", { a: 1 })
t64: agrees(s"{a: number, ..}", { a: "x" })
t65: agrees(s"{a: number, ..}", { a: 1, b: 2 })
t66: agrees(s"[number]", [1, 2])
t67: agrees(s"[number]", [1, "x"])
t68: agrees(s"number | string", 42)
t69: agrees(s"number | string", :sym)
t70: agrees(s"(number, string)", [1, "x"])
t71: agrees(s"(number, string)", [1, 2])
t72: agrees(s"number?", null)
t73: agrees(s"number?", "x")
t74: agrees(s"number", 1)
t75: agrees(s"number", "1")
t76: agrees(s"[number, string…]", [1, "a"])
t77: agrees(s"[number, string…]", ["a", "b"])

##
## Non-type-data specs: an already-projected t-* list is accepted directly
##

t78: ({ a: 1 } validate([:t-record, { a: [:t-field, :required, [:t-prim, :number]] }, false])) nil?
t79: (({ a: 1, b: 2 } validate([:t-record, { a: [:t-field, :required, [:t-prim, :number]] }])) count) = 1

RESULT: if([t1, t2, t3, t4, t5, t6, t7, t8, t9, t10,
            t11, t12, t13, t14, t15, t16, t17, t18, t19, t20,
            t21, t22, t23, t24, t25, t26, t27, t28, t29, t30,
            t31, t32, t33, t34, t35, t36, t37, t38, t39, t40,
            t41, t42, t43, t44, t45, t46, t47, t48, t49, t50,
            t51, t52, t53, t54, t55, t56, t57, t58, t59, t60,
            t61, t62, t63, t64, t65, t66, t67, t68, t69, t70,
            t71, t72, t73, t74, t75, t76, t77, t78, t79] all-true?,
           :PASS, :FAIL)
