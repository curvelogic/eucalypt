"A fixture for nested namespace members."

` "Outer namespace."
outer: {
  ` "Inner namespace."
  inner: {
    ` "Deep function doc."
    deep(x): x
  }

  ` "Scoped value."
  scoped: { helper-hidden: 1, result: helper-hidden }.result

  cfg-undoc: { data-hidden: 1 }

  cfg-private: {
    ` { doc: "Internal docs do not make a namespace." export: :internal }
    private-hidden: 1
  }

  quiet: {
    ` "Quiet member doc."
    loud(x): x
  }
}

` "Level 1."
l1: {
  ` "Level 2."
  l2: {
    ` "Level 3."
    l3: {
      ` "Level 4."
      l4: {
        ` "Level 5."
        l5: {
          ` "Level 6."
          l6: {
            ` "Below the last heading level."
            bottom(x): x
          }
        }
      }
    }
  }
}
